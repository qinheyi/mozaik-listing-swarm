# Leave everything empty to run the no-key MOCK demo (npm run demo).
# Pick ONE live option. Resolution order: MOZAIK_MODE=mock > LLM_* > MINIMAX > OPENAI/ANTHROPIC/GEMINI > mock

# Any OpenAI-compatible Chat Completions endpoint (OpenRouter, DeepSeek, Groq, Ollama, vLLM, ...)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=openai/gpt-4o-mini

# MiniMax (tested; default model MiniMax-M2.7)
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Mozaik built-in providers (default models: gpt-5.4-mini / claude-haiku-4-5 / gemini-3.5-flash; override with LLM_MODEL)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Tuning
# MOZAIK_MODE=mock
# MAX_REVISIONS=2
# MAX_PARALLEL_INFERENCES=12
# RUN_TIMEOUT_MS=900000
# MOCK_SEED=7
# Optional: stream traces to Mozaik Cloud
# MOZAIK_API_KEY=
